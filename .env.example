OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# (CLAUDE_API_KEY is also accepted as an alias for ANTHROPIC_API_KEY)

# Optional: comma-separated browser origins allowed to call the API cross-origin.
# The app is served same-origin, so this is only needed for external front-ends.
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Optional model overrides (defaults shown).
# OpenAI tiers: gpt-5.6-sol (deepest reasoning, also the bare `gpt-5.6` alias),
# gpt-5.6-terra (balanced), gpt-5.6-luna (fastest/cheapest).
# OPENAI_VISION_MODEL=gpt-5.6-terra
# OPENAI_SOLVE_MODEL=gpt-5.6-terra
# GEMINI_MODEL=gemini-3.7-flash
# Claude tiers: claude-opus-5, claude-sonnet-5, or claude-haiku-4-5-20251001
# (cheapest vision-capable).
# CLAUDE_VISION_MODEL=claude-sonnet-5
# CLAUDE_SOLVE_MODEL=claude-sonnet-5

# Optional: pin the Gemini Live (voice mode) model instead of the built-in
# fallback chain, e.g. when a newer live preview ships.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
