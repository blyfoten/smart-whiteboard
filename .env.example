OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: comma-separated browser origins allowed to call the API cross-origin.
# The app is served same-origin, so this is only needed for external front-ends.
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Optional model overrides (defaults shown):
# OPENAI_VISION_MODEL=gpt-5.4
# OPENAI_SOLVE_MODEL=gpt-5.4
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_VISION_MODEL=claude-haiku-4-5
# CLAUDE_SOLVE_MODEL=claude-haiku-4-5
