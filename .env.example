OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# (CLAUDE_API_KEY is also accepted as an alias for ANTHROPIC_API_KEY)

# Optional: comma-separated browser origins allowed to call the API cross-origin.
# The app is served same-origin, so this is only needed for external front-ends.
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Model tiers. The UI's "Model tier" picker sends fast | balanced | max and the
# server maps it to one of these ids (providers/catalogue.js). Defaults shown;
# override any single step without touching code.
# OPENAI_MODEL_FAST=gpt-5.6-luna
# OPENAI_MODEL_BALANCED=gpt-5.6-terra
# OPENAI_MODEL_MAX=gpt-5.6-sol
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_BALANCED=gemini-3.7-flash
# GEMINI_MODEL_MAX=gemini-3.1-pro
# CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
# CLAUDE_MODEL_BALANCED=claude-sonnet-5
# CLAUDE_MODEL_MAX=claude-opus-5

# Legacy single-model pins. When set these win over the tier picker for that
# provider+operation, so an existing deployment keeps its exact behaviour.
# OPENAI_VISION_MODEL=
# OPENAI_SOLVE_MODEL=
# GEMINI_MODEL=
# CLAUDE_VISION_MODEL=
# CLAUDE_SOLVE_MODEL=

# Optional: pin the Gemini Live (voice mode) model instead of the built-in
# fallback chain, e.g. when a newer live preview ships.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Debug / bug-fix mode (the backend coding agent) -------------------------
# Lets the voice assistant hand a problem with the APP ITSELF to a coding agent
# that edits this repository, runs the tests and the build, and pushes a feature
# branch — which the git watcher on the box then deploys.
#
# OFF by default, and deliberately so: anyone who can reach the page can then
# cause commits to this repo. Only enable it on a deployment you control.
# DEBUG_AGENT_ENABLED=1
#
# Optional shared secret for the /debug/* HTTP API, sent as X-Debug-Token. The
# voice path is unaffected (it runs inside the server), but the browser's debug
# panel does not know the token — with this set, sessions are steered by voice
# and the panel cannot post to them.
# DEBUG_AGENT_TOKEN=some-long-random-string
#
# The coding agent's model (Claude, via ANTHROPIC_API_KEY) and its limits.
# DEBUG_AGENT_MODEL=claude-sonnet-5
# DEBUG_AGENT_MAX_STEPS=40
# DEBUG_AGENT_MAX_TOKENS=8000
#
# Identity on the commits the agent makes.
# DEBUG_AGENT_GIT_NAME=Whiteboard Debug Agent
# DEBUG_AGENT_GIT_EMAIL=debug-agent@smart-whiteboard.local
